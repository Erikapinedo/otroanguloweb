{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html",                      "destination": "/",                        "permanent": true },
    { "source": "/about-me-erika-pinedo.html",      "destination": "/sobre-mi",                "permanent": true },
    { "source": "/portfolio.html",                  "destination": "/portafolio",              "permanent": true },
    { "source": "/contact.html",                    "destination": "/contacto",                "permanent": true },
    { "source": "/project-parrotfy.html",           "destination": "/proyectos/parrotfy",      "permanent": true },
    { "source": "/project-nico-seguros.html",       "destination": "/proyectos/nico-seguros",  "permanent": true },
    { "source": "/project-expediente.html",         "destination": "/proyectos/expediente",    "permanent": true },
    { "source": "/project-alessandri.html",         "destination": "/proyectos/alessandri",    "permanent": true },
    { "source": "/project-bluesphere.html",         "destination": "/proyectos/bluesphere",    "permanent": true },
    { "source": "/project-playersnap.html",         "destination": "/proyectos/playersnap",    "permanent": true },
    { "source": "/project-matchminders.html",       "destination": "/proyectos/matchminders",  "permanent": true },
    { "source": "/project-portalpehuen.html",       "destination": "/proyectos/portalpehuen",  "permanent": true },
    { "source": "/project-urbana.html",             "destination": "/proyectos/urbana",        "permanent": true },
    { "source": "/project-jschile.html",            "destination": "/proyectos/jschile",       "permanent": true },
    { "source": "/about-me-erika-pinedo",           "destination": "/sobre-mi",                "permanent": true },
    { "source": "/portfolio",                       "destination": "/portafolio",              "permanent": true },
    { "source": "/contact",                         "destination": "/contacto",                "permanent": true },
    { "source": "/project-alessandri",              "destination": "/proyectos/alessandri",    "permanent": true },
    { "source": "/project-nico-seguros",            "destination": "/proyectos/nico-seguros",  "permanent": true },
    { "source": "/project-parrotfy",                "destination": "/proyectos/parrotfy",      "permanent": true },
    { "source": "/project-expediente",              "destination": "/proyectos/expediente",    "permanent": true },
    { "source": "/project-matchminders",            "destination": "/proyectos/matchminders",  "permanent": true },
    { "source": "/project-jschile",                 "destination": "/proyectos/jschile",       "permanent": true },
    { "source": "/project-bluesphere",              "destination": "/proyectos/bluesphere",    "permanent": true },
    { "source": "/project-playersnap",              "destination": "/proyectos/playersnap",    "permanent": true },
    { "source": "/project-portalpehuen",            "destination": "/proyectos/portalpehuen",  "permanent": true },
    { "source": "/project-urbana",                  "destination": "/proyectos/urbana",        "permanent": true }
  ],
  "rewrites": [
    { "source": "/",      "destination": "/index.html" },
    { "source": "/index", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
