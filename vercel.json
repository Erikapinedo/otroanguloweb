{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html",                      "destination": "/",                        "permanent": true },
    { "source": "/about-me-erika-pinedo.html",      "destination": "/about-me-erika-pinedo",   "permanent": true },
    { "source": "/portfolio.html",                  "destination": "/portfolio",               "permanent": true },
    { "source": "/contact.html",                    "destination": "/contact",                 "permanent": true },
    { "source": "/project-parrotfy.html",           "destination": "/project-parrotfy",        "permanent": true },
    { "source": "/project-nico-seguros.html",       "destination": "/project-nico-seguros",    "permanent": true },
    { "source": "/project-expediente.html",         "destination": "/project-expediente",      "permanent": true },
    { "source": "/project-alessandri.html",         "destination": "/project-alessandri",      "permanent": true },
    { "source": "/project-bluesphere.html",         "destination": "/project-bluesphere",      "permanent": true },
    { "source": "/project-playersnap.html",         "destination": "/project-playersnap",      "permanent": true },
    { "source": "/project-matchminders.html",       "destination": "/project-matchminders",    "permanent": true }
  ],
  "rewrites": [
    { "source": "/",                      "destination": "/index.html" },
    { "source": "/index",                 "destination": "/index.html" },
    { "source": "/about-me-erika-pinedo", "destination": "/about-me-erika-pinedo.html" },
    { "source": "/portfolio",             "destination": "/portfolio.html" },
    { "source": "/contact",               "destination": "/contact.html" },
    { "source": "/project-parrotfy",      "destination": "/project-parrotfy.html" },
    { "source": "/project-nico-seguros",  "destination": "/project-nico-seguros.html" },
    { "source": "/project-expediente",    "destination": "/project-expediente.html" },
    { "source": "/project-alessandri",    "destination": "/project-alessandri.html" },
    { "source": "/project-bluesphere",    "destination": "/project-bluesphere.html" },
    { "source": "/project-playersnap",    "destination": "/project-playersnap.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
